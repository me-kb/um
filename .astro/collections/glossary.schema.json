{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "productName": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string"
          },
          "general_definition": {
            "type": "string"
          },
          "associated_products": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "term",
          "general_definition"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "productName",
    "entries"
  ]
}