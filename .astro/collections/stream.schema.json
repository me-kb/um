{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "transcript": {
      "type": "string"
    },
    "chapters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "thumbnail": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "timestamp": {
              "type": "string"
            }
          },
          "required": [
            "timestamp"
          ]
        }
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title"
  ],
  "additionalProperties": {}
}