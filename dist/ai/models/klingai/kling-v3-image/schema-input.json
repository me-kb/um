{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"prompt":{"type":"string","description":"Text prompt describing the image to generate"},"negative_prompt":{"description":"Negative text prompt","type":"string"},"image":{"description":"Reference image (Base64 encoding or URL) for image-to-image","type":"string"},"resolution":{"default":"1k","description":"Image generation resolution (1k: standard, 2k: high-res)","type":"string","enum":["1k","2k"]},"aspect_ratio":{"default":"16:9","description":"Aspect ratio of generated images","type":"string","enum":["16:9","9:16","1:1","4:3","3:4","3:2","2:3","21:9"]}},"required":["prompt","resolution","aspect_ratio"],"additionalProperties":false}